@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(gz-common)
if(NOT TARGET gz-fuel_tools::gz-fuel_tools)
  include("${CMAKE_CURRENT_LIST_DIR}/gz-fuel_tools-targets.cmake")
endif()

# Preserve the targets and variables generated by upstream gz-cmake. Fuel has
# only its core library, so requested/all both forward to that same library.
foreach(alias IN ITEMS gz-fuel_tools::core gz-fuel_tools::requested gz-fuel_tools::all gz-fuel_tools)
  if(NOT TARGET "${alias}")
    add_library("${alias}" INTERFACE IMPORTED)
    set_target_properties("${alias}" PROPERTIES
      INTERFACE_LINK_LIBRARIES gz-fuel_tools::gz-fuel_tools)
  endif()
endforeach()
set(gz-fuel_tools_CORE_LIBRARY gz-fuel_tools::core)
set(gz-fuel_tools_LIBRARIES gz-fuel_tools::requested)
if(gz-fuel_tools_INCLUDE_DIRS_OVERRIDE)
  set_and_check(gz-fuel_tools_INCLUDE_DIRS "${gz-fuel_tools_INCLUDE_DIRS_OVERRIDE}")
else()
  set_and_check(gz-fuel_tools_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
endif()
set(GZ-FUEL_TOOLS_LIBRARIES "${gz-fuel_tools_LIBRARIES}")
set(GZ-FUEL_TOOLS_INCLUDE_DIRS "${gz-fuel_tools_INCLUDE_DIRS}")
set(gz-fuel_tools_all_FOUND TRUE)
set(gz-fuel_tools-all_FOUND TRUE)
check_required_components(gz-fuel_tools)
